# Multi-stage Dockerfile pour Railway
# Stage 1: Build l'application avec toutes les dépendances
FROM node:20-alpine AS build

WORKDIR /app

# Copier les fichiers de dépendances
COPY package*.json ./

# Installer TOUTES les dépendances (dev incluses pour tsc + vite)
RUN npm ci

# Copier le code source
COPY . .

# Variables d'environnement pour le build Vite
ARG VITE_API_URL
ARG VITE_BASE_PATH
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_BASE_PATH=$VITE_BASE_PATH

# Build de l'application
RUN npm run build

# Stage 2: Image de production légère
FROM node:20-alpine

WORKDIR /app

# Installer serve globalement pour servir les fichiers statiques
RUN npm install -g serve@14

# Copier uniquement les fichiers buildés depuis le stage précédent
COPY --from=build /app/dist ./dist

# Variables d'environnement de production
ENV NODE_ENV=production

EXPOSE 3000

# Servir l'application en mode SPA (fallback vers index.html)
CMD ["serve", "-s", "dist", "-l", "3000"]
